<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>ult-s-setup</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>Ultimate S Setup</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <javafx.version>21.0.2</javafx.version>
        <app.version>1.0</app.version>
        <main.class>com.example.ultssetup.Main</main.class>
        <app.name>UltimateSSetup</app.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.controlsfx</groupId>
            <artifactId>controlsfx</artifactId>
            <version>11.2.1</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!-- 1. Compile -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>

            <!-- 2. Fat JAR: bundles all deps into a single jar for jpackage -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 3. Copy the fat JAR into app-input/ after shade produces it.
                     Bound to prepare-package so resources copy runs first,
                     then antrun copies the JAR in the package phase after shade. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-jar-to-input</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/app-input"/>
                                <copy file="${project.build.directory}/${project.artifactId}-${project.version}.jar"
                                      todir="${project.build.directory}/app-input"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 4. Copy resources/ and fat JAR into a clean app-input dir.
                     jpackage input must contain ONLY what goes into the app —
                     pointing it at target/ causes it to recurse into itself. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-app-resources</id>
                        <phase>prepare-package</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/app-input/resources</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/resources</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!--
    ====================================================================
    PROFILES — one per target platform.
    Each produces a portable app-image (self-contained folder with
    bundled JRE + executable) then zips it up for distribution.
    Users extract the zip anywhere they like and run the executable
    directly — no installation required.

      ./build.sh linux     → target/dist/UltimateSSetup-linux.tar.gz
      ./build.sh windows   → target/dist/UltimateSSetup-windows.zip
      ./build.sh mac       → target/dist/UltimateSSetup-mac.zip
    ====================================================================
    -->

    <profiles>

        <!-- ── LINUX ──────────────────────────────────────────────── -->
        <profile>
            <id>linux</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.5</version>
                        <executions>
                            <execution>
                                <id>jpackage-linux</id>
                                <phase>verify</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <name>${app.name}</name>
                                    <appVersion>${app.version}</appVersion>
                                    <vendor>com.example</vendor>
                                    <description>Ultimate S Setup Tool</description>
                                    <input>${project.build.directory}/app-input</input>
                                    <mainJar>${project.artifactId}-${project.version}.jar</mainJar>
                                    <mainClass>${main.class}</mainClass>
                                    <destination>${project.build.directory}/dist/image</destination>
                                    <type>APP_IMAGE</type>
                                    <javaOptions>
                                        <javaOption>-Dfile.encoding=UTF-8</javaOption>
                                    </javaOptions>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Write the launcher .sh then tar everything up -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>tar-linux</id>
                                <phase>verify</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.build.directory}/dist/out"/>
                                        <!-- Write the launcher script -->
                                        <echo file="${project.build.directory}/dist/launcher/${app.name}.sh">#!/bin/bash
# Launcher — drop this next to the ${app.name}/ folder and run it.
DIR="$(cd "$(dirname "$0")" &amp;&amp; pwd)"
exec "$DIR/${app.name}/bin/${app.name}" "$@"
</echo>
                                        <chmod file="${project.build.directory}/dist/launcher/${app.name}.sh" perm="755"/>
                                        <!-- tar: launcher .sh at the root, app-image in a subfolder -->
                                        <tar destfile="${project.build.directory}/dist/out/${app.name}-linux.tar.gz"
                                             compression="gzip" longfile="posix">
                                            <!-- launcher script at root, executable -->
                                            <tarfileset dir="${project.build.directory}/dist/launcher"
                                                        filemode="755"/>
                                            <!-- resources folder at root alongside the launcher -->
                                            <tarfileset dir="${project.basedir}/resources"
                                                        prefix="resources"/>
                                            <!-- app-image bin dir, executable (no prefix: jpackage already nests in UltimateSSetup/) -->
                                            <tarfileset dir="${project.build.directory}/dist/image"
                                                        filemode="755">
                                                <include name="${app.name}/bin/**"/>
                                            </tarfileset>
                                            <!-- everything else in app-image -->
                                            <tarfileset dir="${project.build.directory}/dist/image">
                                                <exclude name="${app.name}/bin/**"/>
                                            </tarfileset>
                                        </tar>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ── WINDOWS ────────────────────────────────────────────── -->
        <profile>
            <id>windows</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.5</version>
                        <executions>
                            <execution>
                                <id>jpackage-windows</id>
                                <phase>verify</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <name>${app.name}</name>
                                    <appVersion>${app.version}</appVersion>
                                    <vendor>com.example</vendor>
                                    <description>Ultimate S Setup Tool</description>
                                    <input>${project.build.directory}/app-input</input>
                                    <mainJar>${project.artifactId}-${project.version}.jar</mainJar>
                                    <mainClass>${main.class}</mainClass>
                                    <destination>${project.build.directory}/dist/image</destination>
                                    <type>APP_IMAGE</type>
                                    <icon>${project.basedir}/assets/Ultimate S Setup.ico</icon>
                                    <javaOptions>
                                        <javaOption>-Dfile.encoding=UTF-8</javaOption>
                                    </javaOptions>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Zip the app-image into a distributable zip -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>zip-windows</id>
                                <phase>verify</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.build.directory}/dist/out"/>
                                        <zip destfile="${project.build.directory}/dist/out/${app.name}-windows.zip">
                                            <zipfileset dir="${project.build.directory}/dist/image"
                                                        prefix="${app.name}"/>
                                        </zip>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ── macOS ──────────────────────────────────────────────── -->
        <profile>
            <id>mac</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.5</version>
                        <executions>
                            <execution>
                                <id>jpackage-mac</id>
                                <phase>verify</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <name>${app.name}</name>
                                    <appVersion>${app.version}</appVersion>
                                    <vendor>com.example</vendor>
                                    <description>Ultimate S Setup Tool</description>
                                    <input>${project.build.directory}/app-input</input>
                                    <mainJar>${project.artifactId}-${project.version}.jar</mainJar>
                                    <mainClass>${main.class}</mainClass>
                                    <destination>${project.build.directory}/dist/image</destination>
                                    <type>APP_IMAGE</type>
                                    <javaOptions>
                                        <javaOption>-Dfile.encoding=UTF-8</javaOption>
                                    </javaOptions>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Zip the .app bundle into a distributable zip -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>zip-mac</id>
                                <phase>verify</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.build.directory}/dist/out"/>
                                        <zip destfile="${project.build.directory}/dist/out/${app.name}-mac.zip">
                                            <zipfileset dir="${project.build.directory}/dist/image"
                                                        prefix="${app.name}"
                                                        filemode="755">
                                                <include name="**/*.app/Contents/MacOS/**"/>
                                            </zipfileset>
                                            <zipfileset dir="${project.build.directory}/dist/image"
                                                        prefix="${app.name}">
                                                <exclude name="**/*.app/Contents/MacOS/**"/>
                                            </zipfileset>
                                        </zip>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>

</project>